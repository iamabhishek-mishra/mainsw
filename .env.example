# ============================================
#  SUDHA WELLNESS - ENVIRONMENT EXAMPLE
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real ".env" (it contains secrets).
# ============================================

# ---- SERVER ----
# 127.0.0.1 = local only | 0.0.0.0 = bind all interfaces (hosting/VPS)
HOST=127.0.0.1
PORT=3000
# Public URL of the site (used for reference / PhonePe)
APP_PUBLIC_URL=http://localhost:3000

# ---- ADMIN (username + password login) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Legacy X-Admin header secret (kept for API compatibility)
ADMIN_KEY=change_me
ADMIN_EMAIL=admin@example.com

# ---- MAILER (SMTP) ----
SMTP_HOST=smtp.yourhost.com
# 587 = STARTTLS | 465 = implicit SSL (set SMTP_SECURE=true)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Your Store <you@yourdomain.com>
# Folder where emails are logged when SMTP is down (fallback) - e.g. logs
SMTP_LOG_DIR=logs

# ---- PHONEPE (UPI payments) ----
# Leave MERCHANT_ID + SALT_KEY empty for local "simulate" payment mode.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# TEST = sandbox | PROD = live (requires a public HTTPS callback URL)
PHONEPE_ENV=TEST
# Must be a public HTTPS URL in PROD, e.g. https://store.example.com/api/payments/callback
PHONEPE_REDIRECT_URI=

# ---- DATABASE ----
# DB_DRIVER=mysql to use MySQL, otherwise SQLite (data.db) is used.
DB_DRIVER=sqlite
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=